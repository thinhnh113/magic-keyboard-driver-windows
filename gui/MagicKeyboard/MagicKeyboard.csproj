<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- WinForms only, like MagicMouse: one UI framework and no WPF/Direct3D keeps the tray app small. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Not "MagicKeyboardUtilities": that is the vendor app's process name. -->
    <AssemblyName>MagicKeyboard</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MagicKeyboard.Gui</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\MagicKeyboard.ico</ApplicationIcon>
    <AssemblyTitle>MagicKeyboard</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <!-- Regenerate with tools\icon\make-icon.ps1 -->
    <EmbeddedResource Include="Assets\MagicKeyboard.ico" LogicalName="MagicKeyboard.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\shared\MagicKeyboard.Shared\MagicKeyboard.Shared.csproj" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
